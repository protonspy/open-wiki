{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The renderer is a browser: it needs the DOM, and React's automatic
    // runtime so a component file carries no `import React`. The main process
    // runs in Electron's Node and uses neither — one tsconfig covers both
    // because the alternative is two, and a file in the wrong one fails in a
    // way nobody reads.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "tests"]
}
